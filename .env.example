# Copy to .env and adjust. Values here are development defaults.

# Database (compose builds DATABASE_URL for the backend container from these)
POSTGRES_DB=appfit
POSTGRES_USER=appfit
POSTGRES_PASSWORD=appfit
# Local (non-docker) backend and tests:
DATABASE_URL=postgresql+psycopg://appfit:appfit@localhost:5432/appfit

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Embeddings: sentence_transformers (real model) or fake (tests / UI work without the model)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Set to 1 after `appfit download-model` to forbid network access to the model hub
HF_HUB_OFFLINE=0

EMBED_WORKER_ENABLED=true
EMBED_WORKER_POLL_SECONDS=5

# Matching (empty = per-model values from thresholds.yaml)
MATCH_T_COVERED=
MATCH_T_PARTIAL=
MATCH_T_NOMATCH=
MATCH_CANDIDATES=40
RRF_K=60
LEXICAL_BONUS=0.03
SEARCH_LOG_ENABLED=true

LOG_LEVEL=INFO

# Published ports
APPFIT_HTTP_PORT=8080
APPFIT_DB_PORT=5432
APPFIT_API_PORT=8000
APPFIT_WEB_PORT=5173
